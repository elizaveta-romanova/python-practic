import os
import csv
from datetime import datetime, timedelta
from collections import defaultdict

INVENT_DIR = "invent_trans"
STOCK_DIR = "stock"
DELIMITER = ';'

stock_data = defaultdict(dict)

def read_csv(file_path):
    with open(file_path, 'r', encoding='utf-8') as f:
        reader = csv.DictReader(f, delimiter=DELIMITER)
        return [row for row in reader]

def write_csv(file_path, headers, rows):
    with open(file_path, 'w', encoding='utf-8', newline='') as f:
        writer = csv.writer(f, delimiter=DELIMITER)
        writer.writerow(headers)
        writer.writerows(rows)

def parse_qty(value):
    if '!' in value:
        value = value.replace('!', '.')
    elif ',' in value:
        value = value.replace(',', '.')
    return float(value)

def load_initial_stock(date_str):
    file_name = f"stock_{date_str}.csv"
    file_path = os.path.join(STOCK_DIR, file_name)

    if not os.path.exists(file_path):
        print(f"Начальный остаток не найден: {file_name}. Начинаем с нуля.")
        return

    rows = read_csv(file_path)
    for row in rows:
        key = (row['item_id'], row['location_id'])
        qty = parse_qty(row['qty'])
        stock_data[key][date_str] = qty
    print(f"Загружен начальный остаток: {file_name}")

def process_month(year, month):
    month_str = f"{year}_{month:02d}"
    file_name = f"invent_trans_{month_str}.csv"
    file_path = os.path.join(INVENT_DIR, file_name)

    if not os.path.exists(file_path):
        print(f"Файл движений не найден: {file_name}. Пропускаем.")
        return

    rows = read_csv(file_path)
    rows.sort(key=lambda x: x['trans_date'])

    for row in rows:
        item_id = row['item_id']
        location_id = row['location_id']
        trans_date = row['trans_date']
        qty = parse_qty(row['qty'])

        key = (item_id, location_id)

        prev_date = (datetime.strptime(trans_date, '%Y-%m-%d') - timedelta(days=1)).strftime('%Y-%m-%d')
        prev_qty = stock_data[key].get(prev_date, 0.0)

        new_qty = prev_qty + qty
        stock_data[key][trans_date] = new_qty

    print(f"Обработан месяц: {month_str}")

def save_stock(date_str):
    file_name = f"stock_{date_str}.csv"
    file_path = os.path.join(STOCK_DIR, file_name)

    headers = ['item_id', 'location_id', 'trans_date', 'qty', 'cost_amount']
    rows = []

    for (item_id, location_id), dates in stock_data.items():
        qty = dates.get(date_str, 0.0)
        cost_amount = qty * 10.0

        qty_str = str(qty).replace('.', ',')
        cost_str = str(cost_amount).replace('.', ',')

        rows.append([item_id, location_id, date_str, qty_str, cost_str])

    write_csv(file_path, headers, rows)
    print(f"Результат сохранён: {file_name}")

if __name__ == "__main__":
    load_initial_stock("2025_07_01")
    process_month(2025, 7)
    save_stock("2025_07_31")

    print("\n✅ Готово! Файл stock_2025_07_31.csv создан.")
